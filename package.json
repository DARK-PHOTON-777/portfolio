{
	"name": "personal-website",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"prepare": "husky",
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"format": "biome format --write .",
		"validate": "npm run build",
		"precommit": "lint-staged",
		"prepush": "npm run validate"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx}": "biome check --write --no-errors-on-unmatched"
	},
	"dependencies": {
		"next": "^15.5.19",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-icons": "^5.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "15.3.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"tailwindcss": "^4",
		"typescript": "^5"
	}
}
